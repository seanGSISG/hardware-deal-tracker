# Database
POSTGRES_DB=hardware_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@postgres:5432/hardware_tracker

# Backend
# REQUIRED: generate a strong random key (the app refuses to boot otherwise):
#   openssl rand -hex 32
SECRET_KEY=your-super-secret-key-min-32-characters-long-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_PORT=8000
# Host-side port mapping. Default 8001 to avoid conflict with vLLM (which often binds 8000).
BACKEND_HOST_PORT=8001

# Redis
REDIS_URL=redis://redis:6379/0

# eBay API (required for production)
EBAY_APP_ID=your-ebay-app-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_REDIRECT_URI=your-ebay-redirect-uri

# Rate Limiting
EBAY_DAILY_CALL_LIMIT=5000
EBAY_CALL_BUFFER=200
EBAY_NEAR_LIMIT_THRESHOLD=4000

# OpenRouter AI (optional)
OPENROUTER_API_KEY=your-openrouter-api-key

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# From address for outgoing emails (defaults to SMTP_USER when blank)
SMTP_FROM=

# Notifications + Auth
# Master switch for the notification dispatcher (Telegram + email).
NOTIFICATIONS_ENABLED=true
# Public self-service registration. Keep false in production (admin-provisioned users).
ALLOW_REGISTRATION=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Application
USE_MOCK_EBAY=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# AI deal analysis (feature-006) — opt-in
AI_ENABLED=false
AI_PROVIDER=openrouter          # openrouter | vllm
AI_MODEL=                       # blank falls back to OPENROUTER_MODEL
AI_VLLM_BASE_URL=               # e.g. http://dgx-spark:8000/v1 (OpenAI-compatible)

# Semantic catalog matching (feature-006, ADR-006) — STRETCH / OPTIONAL, opt-in.
# Improves listing->catalog attribution and powers a "similar tracked items"
# affordance via pgvector embedding similarity. Requires AI_ENABLED=true AND the
# Postgres service running the pgvector/pgvector:pg17 image (the migration runs
# CREATE EXTENSION IF NOT EXISTS vector). Off by default; the core app, poll/score
# path, and the test suite behave identically when it is false. SEMANTIC_EMBEDDING_DIM
# MUST match the embedding model's output width (text-embedding-3-small -> 1536)
# and the pgvector column width.
ENABLE_SEMANTIC_MATCHING=false
SEMANTIC_EMBEDDING_MODEL=openai/text-embedding-3-small
SEMANTIC_EMBEDDING_DIM=1536

# Community-signal ingestion (feature-007, STRETCH) — opt-in, OFF by default.
# A SEPARATE leads pipeline (Reddit r/homelabsales) that AI-extracts structured
# fields from unstructured posts into a leads surface. NEVER routed through
# scoring/notifications. When false the feature is fully dormant.
ENABLE_COMMUNITY_SIGNAL=false
# COMMUNITY_SIGNAL_DAILY_LIMIT=200   # polite per-source daily bucket (not eBay's 5000)
# COMMUNITY_SIGNAL_FETCH_LIMIT=50    # newest posts pulled per cycle
# COMMUNITY_SIGNAL_INTERVAL=1800     # in-process ingest cadence (seconds) when enabled
# Reddit OAuth creds (leave blank to keep the source a no-op). client_credentials
# grant by default; set REDDIT_USERNAME/PASSWORD for the password grant.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=hardware-deal-tracker/0.2 (community-signal)
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=homelabsales

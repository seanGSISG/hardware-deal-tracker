{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping the hdt backend /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["hardware-deal-tracker", "ebay", "polling"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Hardware Deal Tracker",
  "uid": "hdt-overview",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "eBay Budget Utilization",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 96 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "hdt_rate_budget_utilization_pct", "legendFormat": "utilization", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Calls Today / Remaining",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "hdt_rate_budget_calls_today", "legendFormat": "calls today", "refId": "A" },
        { "expr": "hdt_rate_budget_remaining", "legendFormat": "remaining", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Poll Cycles (rate/min)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "cpm" } },
      "targets": [
        { "expr": "rate(hdt_poll_cycles_total[5m]) * 60", "legendFormat": "poll cycles/min", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Listings Ingested & Scoring Runs (rate/min)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "cpm" } },
      "targets": [
        { "expr": "rate(hdt_listings_ingested_total[5m]) * 60", "legendFormat": "listings ingested/min", "refId": "A" },
        { "expr": "rate(hdt_scoring_runs_total[5m]) * 60", "legendFormat": "scoring runs/min", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "eBay Errors & 429s (rate/min)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "cpm" } },
      "targets": [
        { "expr": "rate(hdt_ebay_errors_total[5m]) * 60", "legendFormat": "errors/min", "refId": "A" },
        { "expr": "rate(hdt_ebay_rate_limited_total[5m]) * 60", "legendFormat": "rate-limited (429)/min", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Poll Tick Duration (p50/p95)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(hdt_poll_tick_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(hdt_poll_tick_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Request Rate by Handler",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (handler)", "legendFormat": "{{handler}}", "refId": "A" }
      ]
    }
  ]
}
